{
	"name": "svelte-gauge",
	"description": "Svelte Gauge Component",
	"author": "elebree",
	"homepage": "https://github.com/elebree/svelte-gauge#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/elebree/svelte-gauge.git"
	},
	"license": "MIT",
	"version": "2.0.2",
	"packageManager": "pnpm@10.28.2",
	"keywords": [
		"component-library",
		"components-library",
		"components",
		"gauge",
		"svelte",
		"sveltekit",
		"svelte-component",
		"ui"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build --mode production && pnpm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "pnpm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test": "playwright test",
		"test:svelte5": "node scripts/test-svelte5.mjs"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": false,
	"svelte": "./dist/index.js",
	"main": "dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": ">=4.0.0 <6.0.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"@types/node": "^26.6.5",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"publint": "^0.3.25",
		"sass": "^1.105.2",
		"svelte": "^4.2.20",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^5.4.21"
	}
}
